# ============================================
# OpenMed Environment Configuration
# ============================================
# Data Sources (all free, no signup needed):
# - DDInter: https://ddinter.scbdd.com (302k real DDI records)
# - OpenFDA: https://api.fda.gov (free, no key needed)
# - RxNorm: https://rxnav.nlm.nih.gov (free, no key needed)
# ============================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openmed
SECRET_KEY=your-super-secret-jwt-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

FEATHERLESS_API_KEY=featherless_api
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
OPENFDA_BASE_URL=https://api.fda.gov/drug
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
